# ============================================
# Legacy Portal Automator — .env.example
# ============================================
# This is a TEMPLATE. Copy it to '.env' and fill in real values.
#
#   Copy in PowerShell:
#   Copy-Item .env.example .env
#
# NEVER commit the real .env file — it's already in .gitignore.

# === Groq API Key (FREE — get yours at https://console.groq.com) ===
# Sign in with Google or GitHub, click "API Keys" → "Create API Key"
GROQ_API_KEY=GROQ_API_KEY=your-groq-api-key-here

# === Model Selection ===
# Default: vision-capable model (supports screenshot grounding for legacy portals)
# === Model Selection ===
# Default: text-only model (fast, free, reliable for clean HTML portals)
GROQ_MODEL=llama-3.3-70b-versatile

# Alternative: vision-capable model (uncomment if you need screenshot grounding)
# Note: may require waitlist access on some Groq accounts
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# === Browser Settings ===
# Set to 'false' when recording your demo video so you can SEE the browser
HEADLESS=true

# === Proxy (optional — leave empty for direct connection) ===
# Format: http://user:pass@host:port
PROXY_URL=

# === Paths ===
# Where downloaded PDFs are saved
DOWNLOAD_DIR=./downloads

# === Agent Limits ===
MAX_STEPS=30
USE_VISION=true

# === Timeouts (seconds) ===
AGENT_TIMEOUT=180

# === Demo Portal Settings (the target we automate) ===
PORTAL_HOST=localhost
PORTAL_PORT=8001