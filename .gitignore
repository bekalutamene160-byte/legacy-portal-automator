# ============================================
# Legacy Portal Automator — .gitignore
# ============================================
# Keeps accidental junk out of git. NEVER commit .env (it has your Groq key).

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/

# === Virtual environments ===
.venv/
venv/
env/
ENV/

# === Environment variables (CRITICAL — contains API keys) ===
.env
.env.local
.env.*.local

# === IDE ===
.vscode/
.idea/
*.swp
*.swo
*~

# === OS ===
.DS_Store
Thumbs.db
desktop.ini

# === Testing & linting caches ===
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
test-results/
playwright-report/

# === Project runtime artifacts ===
portal-agent/downloads/
*.log
logs/

# === Playwright browser binaries (installed per-machine) ===
playwright-browsers/